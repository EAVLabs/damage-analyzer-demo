{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run with Gunicorn",
            "type": "python",
            "justMyCode": true,
            "request": "launch",
            "module": "gunicorn",
            "args": [
                "-w", "4",
                "-b", "0.0.0.0:5000",
                "run:app"
            ],
            "console": "integratedTerminal",
            "env": {
                "FLASK_ENV": "development"
            }
        }
    ]
}
